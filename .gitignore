node_modules/

# Assembled Netlify publish directory (built by scripts/build-dist.mjs)
dist/

# Lighthouse reports (scripts/lighthouse-summary.mjs, .github/workflows/lighthouse.yml)
lhr/
lhr-local/

# Netlify CLI local state
.netlify/
deno.lock

# Local secrets (functions read env from Netlify; nothing here should ever be tracked)
.env
.env.*
!.env.example

# Real RCT replacement-cost table (governor-level). Lives only in the RCT_BENCHMARK_JSON Netlify env var;
# this local copy feeds the public-surface leak test (tests/functions/rct-public-leak.test.js). Never commit it.
/.rct-benchmark.local.json
# Key for the RCT table's HMAC pin (RCT_BENCHMARK_PIN_KEY). Lives in the Netlify env; never commit it.
/.rct-benchmark-pin-key.local

# Claude Code local tooling state (machine-local, never committed)
.claude/launch.json

# Superpowers planning artifacts (session-local, not site content)
docs/superpowers/

# Chat knowledge base: regenerated by scripts/build-kb.mjs on every build (Netlify and
# `npm run verify`), so it is a build artifact, not source. Tracking it dirtied every worktree.
/netlify/edge-functions/knowledge-base.json
